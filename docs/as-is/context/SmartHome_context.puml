@startuml Smart Home Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Smart Home Context Diagram
Person(User, "Пользователь", "Использует умные устройства")

System_Ext(Device, "Система отопления", "Устройство отопления пользователя")

Enterprise_Boundary(SmartHomeSystem, "Экосистема умного дома") {
  System_Boundary(Connector, "Domain: Подключение устройств") {
    Person(Installer, "Специалист", "Устанавливает и настраивает устройства")
  }

  System_Boundary(Handlers, "Domain: Управление устройствами") {
    System(DeviceHandler, "Сервис управления отоплением")
  }

}

Rel(User, Installer, "Вызывает специалиста")
Rel(Installer, Device, "Подключает систему")
Rel(User, DeviceHandler, "Управляет умным домом")
BiRel(DeviceHandler, Device, "Отправляет команды и получает данные с датчиков")

@enduml
